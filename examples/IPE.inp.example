&SPACEMANAGEMENT
 GRID_FILE = 'IPE_Grid.h5',
/
&TIMESTEPPING
 TIME_STEP         = 300D0,
 START_TIME        = 0.0D0,
 END_TIME          = 86400.0D0,
 MSIS_TIME_STEP    = 900.D0,
 INITIAL_TIMESTAMP = 2023010100
/
&FORCING
 SOLAR_FORCING_TIME_STEP   = 60.0D0,
 F107_KP_SIZE              = 1500,
 F107_KP_INTERVAL          = 60,
 F107_KP_SKIP_SIZE         = 0,
 F107_KP_DATA_SIZE         = 1500,
 F107_KP_READ_IN_START     = 0,
 F107_KP_FILE              = './wam_input_f107_kp.txt',
 F107_KP_REALTIME_INTERVAL = 60
/
&FILEIO
 READ_APEX_NEUTRALS        = F,
 WRITE_APEX_NEUTRALS       = T,
 WRITE_GEOGRAPHIC_NEUTRALS = T,
 FILE_OUTPUT_FREQUENCY     = 3600.0D0,
 FILE_PREFIX               = 'output/IPE_State.apex.'
/
&ipecap
 mesh_height_min = 0.
 mesh_height_max = 2000.
 mesh_write      = 0
 mesh_write_file = 'ipemesh'
 mesh_fill       = 1
/
&ELDYN
 DYNAMO_EFIELD = T
/
&OPERATIONAL
 COLFAC                = 1.3
 OFFSET1_DEG           = 5.0
 OFFSET2_DEG           = 20.0
 POTENTIAL_MODEL       = 2
 HPEQ                  = 0.0
 TRANSPORT_HIGHLAT_LP  = 30
 PERP_TRANSPORT_MAX_LP = 151
 VERTICAL_WIND_LIMIT   = 100.0
/

! Neutral source. With no &NeutralFileIO block (or READ_GSM_NEUTRALS=F) IPE uses
! MSIS-HWM. For file-based neutrals set T and point GSM_NEUTRALS_DIR at the
! gsm.*.nc files; the reader picks the 90x91 or high-res path from the file size.
!&NeutralFileIO
!  READ_GSM_NEUTRALS     = T,
!  GSM_NEUTRALS_DIR      = '/path/to/gsm_files/',
!  NEUTRAL_INTERP_METHOD = 'linear',
!  VERBOSE_DIAG_LOCAL    = F,
!  NEUTRAL_T_SCALE=1.0, NEUTRAL_O_SCALE=1.0, NEUTRAL_O2_SCALE=1.0, NEUTRAL_N2_SCALE=1.0
!/

! Cold start (no initial condition needed): set HPEQ above to 1.0 and pass any
! valid IPE_State file as the IC; the plasma is re-initialised analytically.
